counter


import React, { useState } from 'react';
import { Button } from '@mui/material';

const Counter = () => {
  const [count, setC] = useState(0);

  const incre = () => {
    setC(count + 1);
  };

  const decre = () => {
    setC(count - 1);
  };

  return (
    <div>
      <h1>COUNTER {count}</h1>
      <Button variant="contained" color="success" onClick={incre}>+</Button>
      <br /><br />
      <Button variant="contained" color="secondary" onClick={decre}>-</Button>
    </div>
  );
};

export default Counter;






