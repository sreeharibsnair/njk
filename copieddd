import React, { useState, useEffect } from 'react'

const Name = () => {
    const [name, setname] = useState("")

    const inpt2 = () => {
        setname("Angular")
    }

    const inpt3 = () => {
        setname("Python")
    }

    useEffect(() => {
        inpt2()
    }, [])

    return (
        <div>
            <h3>Welcome {name}</h3>
            <button onClick={inpt2}>Change to Angular</button>
            <button onClick={inpt3}>Change to Python</button>
        </div>
    )
}

export default Name
