import React, { useState } from 'react'
import { Button } from '@mui/material'

const ButtonCh = () => {
    const [name, setName] = useState("")

    const handleClick = (tech) => {
        setName(tech)
    }

    return (
        <div>
            <br />
            {/* Display the welcome message only if a button has been clicked */}
            {name && <h1>Welcome to {name}</h1>}
            
            <Button variant='contained' onClick={() => handleClick("React.js")}>
                React.js
            </Button>
            <Button variant='contained' onClick={() => handleClick("Express.js")}>
                Express.js
            </Button>
            <Button variant='contained' onClick={() => handleClick("Node.js")}>
                Node.js
            </Button>
        </div>
    )
}

export default ButtonCh
